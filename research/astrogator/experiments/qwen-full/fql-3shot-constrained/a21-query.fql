install ssh client from remote "controller" to remote "controller"; install ssh server from remote "controller" to remote "controller"; start ssh client from remote "controller" to remote "controller"; start ssh server from remote "controller" to remote "controller"; if os is Debian then create ssh key with name="fizbaz" at "/root/.ssh/fizbaz_rsa"; if os is RedHat then create ssh key with name="fizbaz" at "/root/.ssh/fizbaz_rsa"
