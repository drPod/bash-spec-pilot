action install postfix from remote "http://example.com/cfg.redhat" if os is RedHat; action install postfix from remote "http://example.com/cfg.ubuntu" if os is Ubuntu; action download postfix default config to remote "http://example.com/cfg.ubuntu" if os is Ubuntu; action download postfix default config to remote "http://example.com/cfg.redhat" if os is RedHat; action copy postconf from remote "http://example.com/cfg.ubuntu" to remote "http://example.com/cfg.redhat"; action copy postconf from remote "http://example.com/cfg.redhat" to remote "http://example.com/cfg.ubuntu";
