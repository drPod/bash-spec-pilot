relay_prim =
fun (a : atom) (s : shell_state) (rc : BinNums.Z) (t : shell_state) =>
match a with
| Relay =>
    exists pending : list Integers.Byte.int,
      Reach.RelayReach.outcome (os s) rc (os t) pending /\
      lost t = (lost s ++ pending)%list
| Mark b => rc = BinNums.Z0 /\ os t = deliver (os s) b /\ lost t = lost s
end
     : primitive atom shell_state
