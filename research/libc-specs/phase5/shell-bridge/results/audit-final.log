       rc <> BinNums.Z0 /\
       (rc = BinNums.Zpos BinNums.xH \/
        rc = BinNums.Zpos (BinNums.xO BinNums.xH)) /\
       (exists extra pending : list Integers.Byte.int,
          Protocol.RelayProtocol.delivered (os t) =
          (Protocol.RelayProtocol.delivered (os s) ++ extra)%list /\
          lost t = (lost s ++ pending)%list /\
          (extra ++ pending ++ Protocol.RelayProtocol.unread (os t))%list =
          Protocol.RelayProtocol.unread (os s) /\
          (rc = BinNums.Zpos BinNums.xH -> pending = nil) /\
