@command_refines
     : forall (Atom C A : Type) (concrete : primitive Atom C)
         (abstract : primitive Atom A) (R : C -> A -> Prop),
       primitive_refines concrete abstract R ->
       forall (cmd : command Atom) (c c' : C) (rc : BinNums.Z),
       exec concrete cmd c rc c' ->
       forall a : A,
       R c a -> exists a' : A, exec abstract cmd a rc a' /\ R c' a'
@query_transfer
     : forall (Atom C A : Type) (concrete : primitive Atom C)
         (abstract : primitive Atom A) (R : C -> A -> Prop),
       primitive_refines concrete abstract R ->
       forall (cmd : command Atom) (c : C) (a : A),
       R c a ->
       forall (Q : BinNums.Z -> A -> Prop) (P : BinNums.Z -> C -> Prop),
       (forall (rc : BinNums.Z) (a' : A),
        exec abstract cmd a rc a' -> Q rc a') ->
       (forall (rc : BinNums.Z) (c' : C) (a' : A),
        R c' a' -> Q rc a' -> P rc c') ->
       forall (rc : BinNums.Z) (c' : C), exec concrete cmd c rc c' -> P rc c'
