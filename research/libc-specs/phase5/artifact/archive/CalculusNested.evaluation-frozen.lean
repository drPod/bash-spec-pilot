/-!
# CalculusNested: transcription of the nested-state / control fragment of the pinned
# State Calculus interpreter WITH the private patches of the calculus-bytes adapter

Worker: Claude (calculus-resume-2), 2026-09-07. Upstream: `counc009/state_based`, branch
`bash`, commit `190dd8491b258d8a0ee29f79629908540236b332`, `bash-verifier/lib/calculus/`
`interp.ml` + `state.ml` (`ConcreteState`), read together with the two private semantic
patches used by `research/libc-specs/phase5/calculus-bytes/adapter/`:

* `state_concrete_nested.patch` — `set_attr`/`pos_elem`/`neg_elem` rebuild the enclosing
  state on `Nested` paths (the pinned code returned the nested state as the whole state);
* `interp_element_path.patch` — `Element (b, e, a)` APPENDS the hop `(e, a)` to the path of
  `b`, so paths are read outermost-first, which is how every walker in `state.ml` and
  `Value.string_of_value` read them (the pinned producer prepended).

Also transcribed: the v2 adapter's builtin semantics for integers (63-bit carrier with
trapping overflow, truncating division, `Range` assertions) and the interpreter cases
`Pass, Seq, Assign, Action, Add (QualAttr/QualPosE/QualNegE), Get, Contains, Cond, While,
TryCatch, TryFinally, Raise, Return`. NOT transcribed: the byte-list builtins (they stay a
trusted OCaml boundary), `Match`, `ForEach`, `ForElem`, `Localize`, `Yield`, the randomized
state, and state references used as element KEYS (element arguments here are data values).

**Trust boundary.** Nothing here is extracted from or checked against the OCaml source by a
machine. The transcription is compared empirically: `NestedFixtures.lean` (generated by
`calculus-bytes/make_lean_fixtures.py` from the lowered S-expressions the OCaml driver
printed and hashed) is executed by `interp` below and its JSON is compared with the OCaml
driver's output by `calculus-bytes/compare_lean_v2.py`. The theorems below are about this
transcription only; they are not theorems about the OCaml program.
-/

namespace CalculusNested

inductive Lit where
  | unit
  | bool (b : Bool)
  | int (n : Int)
  | str (s : String)
  deriving DecidableEq, Repr

/-- Data values (OCaml `Value.t` without `SRef`, `Left/Right`, `Struct`). -/
inductive Val where
  | lit (l : Lit)
  | pair (a b : Val)
  deriving DecidableEq, Repr

/-- State paths (OCaml `Value.s`), read OUTERMOST-FIRST: `nested n v rest` is element
    `n(v)` of the current state, then `rest` inside it. -/
inductive Path where
  | here
  | nested (name : String) (arg : Val) (rest : Path)
  deriving DecidableEq, Repr

/-- Append a hop at the inner end of a path (the patched `Element` case). -/
def Path.snoc : Path → String → Val → Path
  | .here, n, v => .nested n v .here
  | .nested m w rest, n, v => .nested m w (rest.snoc n v)

/-- Runtime values: data or a state reference (`SRef`). -/
inductive RVal where
  | v (x : Val)
  | sref (p : Path)
  deriving DecidableEq, Repr

inductive Func where
  | add | sub | mul | div | mod | lt | le | gt | ge | eq | ne | neg | lnot | fst | snd
  | excTag (t : String)
  | range (lo hi : Int)
  deriving DecidableEq, Repr

inductive Expr where
  | lit (l : Lit)
  | var (x : String)
  | pair (a b : Expr)
  | fn (f : Func) (e : Expr)
  | elem (base : Expr) (name : String) (arg : Expr)
  deriving Repr

inductive Stmt (Act : Type) where
  | pass
  | seq (a b : Stmt Act)
  | action (v : String) (a : Act) (e : Expr)
  | assign (v : String) (e : Expr)
  | setAttr (base : Expr) (attr : String) (e : Expr)
  | addElem (base : Expr) (name : String) (e : Expr)
  | removeElem (base : Expr) (name : String) (e : Expr)
  | get (v : String) (base : Expr) (attr : String)
  | contains (base : Expr) (name : String) (e : Expr) (t f : Stmt Act)
  | cond (c : Expr) (t e : Stmt Act)
  | while (c : Expr) (body : Stmt Act)
  | tryCatch (body : Stmt Act) (v : String) (handler : Stmt Act)
  | tryFinally (body fin : Stmt Act)
  | raise (e : Expr)
  | ret (e : Expr)
  deriving Repr

/-! ## Association lists (OCaml `Map`s; only lookup / add / remove are used) -/

def lookup {α β : Type} [DecidableEq α] : List (α × β) → α → Option β
  | [], _ => none
  | (k, x) :: rest, a => if k = a then some x else lookup rest a

def assocSet {α β : Type} [DecidableEq α] : List (α × β) → α → β → List (α × β)
  | [], a, y => [(a, y)]
  | (k, x) :: rest, a, y => if k = a then (k, y) :: rest else (k, x) :: assocSet rest a y

def assocRemove {α β : Type} [DecidableEq α] : List (α × β) → α → List (α × β)
  | [], _ => []
  | (k, x) :: rest, a => if k = a then assocRemove rest a else (k, x) :: assocRemove rest a

theorem lookup_assocSet_same {α β : Type} [DecidableEq α] (l : List (α × β)) (a : α) (y : β) :
    lookup (assocSet l a y) a = some y := by
  induction l with
  | nil => simp [assocSet, lookup]
  | cons kx rest ih =>
    obtain ⟨k, x⟩ := kx
    by_cases h : k = a
    · subst h; simp [assocSet, lookup]
    · simp [assocSet, lookup, h, ih]

theorem lookup_assocSet_other {α β : Type} [DecidableEq α] (l : List (α × β)) (a b : α) (y : β)
    (h : b ≠ a) : lookup (assocSet l a y) b = lookup l b := by
  induction l with
  | nil => simp [assocSet, lookup, Ne.symm h]
  | cons kx rest ih =>
    obtain ⟨k, x⟩ := kx
    by_cases hk : k = a
    · subst hk; simp [assocSet, lookup, Ne.symm h]
    · simp [assocSet, lookup, hk, ih]

theorem lookup_assocRemove_same {α β : Type} [DecidableEq α] (l : List (α × β)) (a : α) :
    lookup (assocRemove l a) a = none := by
  induction l with
  | nil => simp [assocRemove, lookup]
  | cons kx rest ih =>
    obtain ⟨k, x⟩ := kx
    by_cases h : k = a
    · subst h; simp [assocRemove, ih]
    · simp [assocRemove, lookup, h, ih]

theorem lookup_assocRemove_other {α β : Type} [DecidableEq α] (l : List (α × β)) (a b : α)
    (h : b ≠ a) : lookup (assocRemove l a) b = lookup l b := by
  induction l with
  | nil => simp [assocRemove, lookup]
  | cons kx rest ih =>
    obtain ⟨k, x⟩ := kx
    by_cases hk : k = a
    · subst hk; simp [assocRemove, lookup, Ne.symm h, ih]
    · simp [assocRemove, lookup, hk, ih]

/-! ## The concrete state tree (OCaml `ConcreteState.t`) and the PATCHED walkers -/

inductive St where
  | mk (attrs : List (String × Val)) (elems : List ((String × Val) × St))

def St.attrs : St → List (String × Val) | .mk a _ => a
def St.elems : St → List ((String × Val) × St) | .mk _ e => e
def St.empty : St := .mk [] []

/-- Constructor-restricted unfolding of `St.mk`'s projections: unlike `St.attrs`/`St.elems`
    (which would also delta-unfold an abstract state and hide it from a `lookup st.elems _`
    hypothesis), this only fires on a literal `St.mk`, which is all `simp` needs to reduce
    the freshly-built states `setAttrAt`/`addElemAt`/`removeElemAt` return. -/
@[simp] theorem St.mk_attrs (a : List (String × Val)) (e : List ((String × Val) × St)) :
    (St.mk a e).attrs = a := rfl
@[simp] theorem St.mk_elems (a : List (String × Val)) (e : List ((String × Val) × St)) :
    (St.mk a e).elems = e := rfl

/-- `get_attr` (unchanged upstream): descend outermost-first, then read the attribute. -/
def getAttrAt : Path → St → String → Option Val
  | .here, st, a => lookup st.attrs a
  | .nested n v rest, st, a =>
    match lookup st.elems (n, v) with
    | none => none
    | some sub => getAttrAt rest sub a

/-- `set_attr` WITH `state_concrete_nested.patch`: the enclosing state is rebuilt. -/
def setAttrAt : Path → St → String → Val → Option St
  | .here, st, a, x => some (.mk (assocSet st.attrs a x) st.elems)
  | .nested n v rest, st, a, x =>
    match lookup st.elems (n, v) with
    | none => none
    | some sub =>
      match setAttrAt rest sub a x with
      | none => none
      | some sub' => some (.mk st.attrs (assocSet st.elems (n, v) sub'))

/-- `pos_elem` WITH the patch (`add_if_absent` at the end of the path). -/
def addElemAt : Path → St → String → Val → Option St
  | .here, st, n, v =>
    some (.mk st.attrs (match lookup st.elems (n, v) with
                        | some _ => st.elems
                        | none => assocSet st.elems (n, v) St.empty))
  | .nested m w rest, st, n, v =>
    match lookup st.elems (m, w) with
    | none => none
    | some sub =>
      match addElemAt rest sub n v with
      | none => none
      | some sub' => some (.mk st.attrs (assocSet st.elems (m, w) sub'))

/-- `neg_elem` WITH the patch. -/
def removeElemAt : Path → St → String → Val → Option St
  | .here, st, n, v => some (.mk st.attrs (assocRemove st.elems (n, v)))
  | .nested m w rest, st, n, v =>
    match lookup st.elems (m, w) with
    | none => none
    | some sub =>
      match removeElemAt rest sub n v with
      | none => none
      | some sub' => some (.mk st.attrs (assocSet st.elems (m, w) sub'))

/-- `check_elem` (unchanged upstream): a missing intermediate element reads as absent. -/
def hasElemAt : Path → St → String → Val → Bool
  | .here, st, n, v => (lookup st.elems (n, v)).isSome
  | .nested m w rest, st, n, v =>
    match lookup st.elems (m, w) with
    | none => false
    | some sub => hasElemAt rest sub n v

/-! ## Frame theorems for the patched mutators

These are the properties the deep-nesting fixture `nested_state.sc` checks by execution
against the patched OCaml (parent and sibling preservation); here they hold for every path,
attribute and state of the transcription. -/

theorem setAttrAt_same : ∀ (p : Path) (st st' : St) (a : String) (x : Val),
    setAttrAt p st a x = some st' → getAttrAt p st' a = some x := by
  intro p
  induction p with
  | here =>
    intro st st' a x h
    simp only [setAttrAt, Option.some.injEq] at h
    subst h
    simp [getAttrAt, St.attrs, lookup_assocSet_same]
  | nested n v rest ih =>
    intro st st' a x h
    simp only [setAttrAt] at h
    split at h
    · cases h
    · rename_i sub hsub
      split at h
      · cases h
      · rename_i sub' hsub'
        simp only [Option.some.injEq] at h
        subst h
        simp [getAttrAt, St.elems, lookup_assocSet_same, ih sub sub' a x hsub']

/-- Writing attribute `a` at path `p` changes no other (path, attribute) pair: the parent's
    attributes, sibling elements and every unrelated subtree are preserved. -/
theorem setAttrAt_frame : ∀ (p : Path) (st st' : St) (a : String) (x : Val),
    setAttrAt p st a x = some st' →
    ∀ (q : Path) (b : String), (q ≠ p ∨ b ≠ a) → getAttrAt q st' b = getAttrAt q st b := by
  intro p
  induction p with
  | here =>
    intro st st' a x h q b hne
    simp only [setAttrAt, Option.some.injEq] at h
    subst h
    cases q with
    | here =>
      have hb : b ≠ a := by
        rcases hne with h1 | h1
        · exact absurd rfl h1
        · exact h1
      simp [getAttrAt, St.attrs, lookup_assocSet_other _ _ _ _ hb]
    | nested m w rest => simp [getAttrAt, St.elems]
  | nested n v rest ih =>
    intro st st' a x h q b hne
    simp only [setAttrAt] at h
    split at h
    · cases h
    · rename_i sub hsub
      split at h
      · cases h
      · rename_i sub' hsub'
        simp only [Option.some.injEq] at h
        subst h
        cases q with
        | here => simp [getAttrAt, St.attrs]
        | nested m w rest' =>
          by_cases hk : (m, w) = (n, v)
          · obtain ⟨rfl, rfl⟩ := Prod.mk.inj hk
            have hr : rest' ≠ rest ∨ b ≠ a := by
              rcases hne with h1 | h1
              · left; intro he; exact h1 (by rw [he])
              · right; exact h1
            simp [getAttrAt, lookup_assocSet_same, hsub, ih sub sub' a x hsub' rest' b hr]
          · simp [getAttrAt, St.elems, lookup_assocSet_other _ _ _ _ hk]

theorem getAttrAt_empty (q : Path) (b : String) : getAttrAt q St.empty b = none := by
  cases q <;> simp [getAttrAt, St.empty, St.attrs, St.elems, lookup]

/-- Touching an element never changes any attribute anywhere (a fresh element is empty;
    an existing one is kept with its attributes: `add_if_absent`). -/
theorem addElemAt_attrs : ∀ (p : Path) (st st' : St) (n : String) (v : Val),
    addElemAt p st n v = some st' →
    ∀ (q : Path) (b : String), getAttrAt q st' b = getAttrAt q st b := by
  intro p
  induction p with
  | here =>
    intro st st' n v h q b
    cases hlk : lookup st.elems (n, v) with
    | some existing =>
      simp only [addElemAt, hlk, Option.some.injEq] at h
      subst h
      cases q with
      | here => simp [getAttrAt, St.attrs]
      | nested m w rest => simp [getAttrAt, St.elems]
    | none =>
      simp only [addElemAt, hlk, Option.some.injEq] at h
      subst h
      cases q with
      | here => simp [getAttrAt, St.attrs]
      | nested m w rest =>
        by_cases hk : (m, w) = (n, v)
        · obtain ⟨rfl, rfl⟩ := Prod.mk.inj hk
          simp [getAttrAt, lookup_assocSet_same, hlk, getAttrAt_empty]
        · simp [getAttrAt, St.elems, lookup_assocSet_other _ _ _ _ hk]
  | nested m0 w0 rest ih =>
    intro st st' n v h q b
    simp only [addElemAt] at h
    split at h
    · cases h
    · rename_i sub hsub
      split at h
      · cases h
      · rename_i sub' hsub'
        simp only [Option.some.injEq] at h
        subst h
        cases q with
        | here => simp [getAttrAt, St.attrs]
        | nested m w rest' =>
          by_cases hk : (m, w) = (m0, w0)
          · obtain ⟨rfl, rfl⟩ := Prod.mk.inj hk
            simp [getAttrAt, lookup_assocSet_same, hsub, ih sub sub' n v hsub' rest' b]
          · simp [getAttrAt, St.elems, lookup_assocSet_other _ _ _ _ hk]

/-- Clearing an element at the root keeps the root attributes and every sibling element. -/
theorem removeElemAt_here_frame (st st' : St) (n : String) (v : Val)
    (h : removeElemAt .here st n v = some st') :
    st'.attrs = st.attrs ∧ ∀ (m : String) (w : Val), (m, w) ≠ (n, v) →
      lookup st'.elems (m, w) = lookup st.elems (m, w) := by
  simp only [removeElemAt, Option.some.injEq] at h
  subst h
  refine ⟨rfl, ?_⟩
  intro m w hk
  simp [St.elems, lookup_assocRemove_other _ _ _ hk]

/-! ## Builtins (adapter v2 integer semantics) and expression evaluation -/

def minInt : Int := -(2 ^ 62)
def maxInt : Int := 2 ^ 62 - 1

/-- carrier check: the OCaml 63-bit int; results outside it trap (`None`). -/
def checked (n : Int) : Option Val :=
  if minInt ≤ n ∧ n ≤ maxInt then some (.lit (.int n)) else none

def funcDef : Func → Val → Option Val
  | .add, .pair (.lit (.int a)) (.lit (.int b)) => checked (a + b)
  | .sub, .pair (.lit (.int a)) (.lit (.int b)) => checked (a - b)
  | .mul, .pair (.lit (.int a)) (.lit (.int b)) => checked (a * b)
  | .div, .pair (.lit (.int a)) (.lit (.int b)) => if b = 0 then none else checked (Int.tdiv a b)
  | .mod, .pair (.lit (.int a)) (.lit (.int b)) => if b = 0 then none else some (.lit (.int (Int.tmod a b)))
  | .lt, .pair (.lit (.int a)) (.lit (.int b)) => some (.lit (.bool (decide (a < b))))
  | .le, .pair (.lit (.int a)) (.lit (.int b)) => some (.lit (.bool (decide (a ≤ b))))
  | .gt, .pair (.lit (.int a)) (.lit (.int b)) => some (.lit (.bool (decide (b < a))))
  | .ge, .pair (.lit (.int a)) (.lit (.int b)) => some (.lit (.bool (decide (b ≤ a))))
  | .eq, .pair (.lit x) (.lit y) => some (.lit (.bool (decide (x = y))))
  | .ne, .pair (.lit x) (.lit y) => some (.lit (.bool (decide (x ≠ y))))
  | .neg, .lit (.int a) => checked (-a)
  | .lnot, .lit (.bool b) => some (.lit (.bool (!b)))
  | .fst, .pair a _ => some a
  | .snd, .pair _ b => some b
  | .excTag t, .pair (.lit (.str s)) _ => some (.lit (.bool (decide (s = t))))
  | .range lo hi, .lit (.int n) => if lo ≤ n ∧ n ≤ hi then some (.lit (.int n)) else none
  | _, _ => none

abbrev Env := List (String × RVal)

def evalExpr (env : Env) : Expr → Option RVal
  | .lit l => some (.v (.lit l))
  | .var x => lookup env x
  | .pair a b =>
    match evalExpr env a, evalExpr env b with
    | some (.v a), some (.v b) => some (.v (.pair a b))
    | _, _ => none
  | .fn f e =>
    match evalExpr env e with
    | some (.v x) => (funcDef f x).map RVal.v
    | _ => none
  | .elem base n arg =>
    match evalExpr env base, evalExpr env arg with
    | some (.sref p), some (.v a) => some (.sref (p.snoc n a))
    | _, _ => none

inductive Res where
  | continue (env : Env) (st : St)
  | raise (v : Val) (env : Env) (st : St)
  | ret (v : Val) (env : Env) (st : St)
  | failure

def initEnv : Env := [("σ", .sref .here)]
def calleeEnv (arg : RVal) : Env := [("ι", arg), ("σ", .sref .here)]

/-- Transcription of `interp`; `fuel` is consumed at every step (the OCaml recursion is
    unbounded through `Action` and `While`). -/
def interp {Act : Type} (actDef : Act → Stmt Act) : Nat → Stmt Act → Env → St → Res
  | 0, _, _, _ => .failure
  | fuel + 1, s, env, st =>
    match s with
    | .pass => .continue env st
    | .seq a b =>
      match interp actDef fuel a env st with
      | .continue env st => interp actDef fuel b env st
      | r => r
    | .raise e =>
      match evalExpr env e with
      | some (.v x) => .raise x env st
      | _ => .failure
    | .ret e =>
      match evalExpr env e with
      | some x => .ret (match x with | .v x => x | .sref _ => .lit .unit) env st
      | none => .failure
    | .assign v e =>
      match evalExpr env e with
      | some x => .continue (assocSet env v x) st
      | none => .failure
    | .action v a e =>
      match evalExpr env e with
      | none => .failure
      | some arg =>
        match interp actDef fuel (actDef a) (calleeEnv arg) st with
        | .ret res _ st => .continue (assocSet env v (.v res)) st
        | .raise x _ st => .raise x env st
        | _ => .failure
    | .setAttr base attr e =>
      match evalExpr env base, evalExpr env e with
      | some (.sref p), some (.v x) =>
        match setAttrAt p st attr x with
        | some st => .continue env st
        | none => .failure
      | _, _ => .failure
    | .addElem base n e =>
      match evalExpr env base, evalExpr env e with
      | some (.sref p), some (.v x) =>
        match addElemAt p st n x with
        | some st => .continue env st
        | none => .failure
      | _, _ => .failure
    | .removeElem base n e =>
      match evalExpr env base, evalExpr env e with
      | some (.sref p), some (.v x) =>
        match removeElemAt p st n x with
        | some st => .continue env st
        | none => .failure
      | _, _ => .failure
    | .get v base attr =>
      match evalExpr env base with
      | some (.sref p) =>
        match getAttrAt p st attr with
        | some x => .continue (assocSet env v (.v x)) st
        | none => .failure
      | _ => .failure
    | .contains base n e t f =>
      match evalExpr env base, evalExpr env e with
      | some (.sref p), some (.v x) =>
        if hasElemAt p st n x then interp actDef fuel t env st else interp actDef fuel f env st
      | _, _ => .failure
    | .cond c t e =>
      match evalExpr env c with
      | some (.v (.lit (.bool true))) => interp actDef fuel t env st
      | some (.v (.lit (.bool false))) => interp actDef fuel e env st
      | _ => .failure
    | .while c body =>
      match evalExpr env c with
      | some (.v (.lit (.bool false))) => .continue env st
      | some (.v (.lit (.bool true))) => interp actDef fuel (.seq body (.while c body)) env st
      | _ => .failure
    | .tryCatch body v handler =>
      match interp actDef fuel body env st with
      | .raise x env st => interp actDef fuel handler (assocSet env v (.v x)) st
      | r => r
    | .tryFinally body fin =>
      match interp actDef fuel body env st with
      | .continue env st => interp actDef fuel fin env st
      | .raise x env st =>
        match interp actDef fuel fin env st with
        | .continue env st => .raise x env st
        | r => r
      | .ret x env st =>
        match interp actDef fuel fin env st with
        | .continue env st => .ret x env st
        | r => r
      | .failure => .failure

/-! ## The v2 short-circuit lowering pattern, in general

`e1 && e2` is lowered to `p1; t := e1'; if t then (p2; t := e2') else pass` and `e1 || e2` to
`p1; t := e1'; if t then pass else (p2; t := e2')`. Whatever the right operand is (an
effectful action call or a trapping `1 / 0`), it is not evaluated when the left operand
decides. -/

theorem and_skips_rhs {Act : Type} (actDef : Act → Stmt Act) (fuel : Nat) (t : String) (l : Expr)
    (rhs : Stmt Act) (env : Env) (st : St)
    (h : evalExpr env l = some (.v (.lit (.bool false)))) :
    interp actDef (fuel + 3) (.seq (.assign t l) (.cond (.var t) rhs .pass)) env st =
      .continue (assocSet env t (.v (.lit (.bool false)))) st := by
  simp [interp, evalExpr, h, lookup_assocSet_same]

theorem or_skips_rhs {Act : Type} (actDef : Act → Stmt Act) (fuel : Nat) (t : String) (l : Expr)
    (rhs : Stmt Act) (env : Env) (st : St)
    (h : evalExpr env l = some (.v (.lit (.bool true)))) :
    interp actDef (fuel + 3) (.seq (.assign t l) (.cond (.var t) .pass rhs)) env st =
      .continue (assocSet env t (.v (.lit (.bool true)))) st := by
  simp [interp, evalExpr, h, lookup_assocSet_same]

/-! ## JSON rendering for the empirical comparison with the OCaml driver -/

def Val.render : Val → String
  | .lit .unit => "\"()\""
  | .lit (.bool b) => if b then "true" else "false"
  | .lit (.int n) => toString n
  | .lit (.str s) => "\"" ++ s ++ "\""
  | .pair a b => "[" ++ a.render ++ ", " ++ b.render ++ "]"

/-- OCaml `V.string_of_value` for the element argument (ints only in these fixtures). -/
def Val.argText : Val → String
  | .lit (.int n) => toString n
  | .lit (.bool b) => toString b
  | .lit .unit => "()"
  | .lit (.str s) => "\"" ++ s ++ "\""
  | .pair a b => "(" ++ a.argText ++ ", " ++ b.argText ++ ")"

partial def St.render : St → String
  | .mk attrs elems =>
    let as := attrs.map fun (k, v) => "\"" ++ k ++ "\": " ++ v.render
    let es := elems.map fun ((n, v), sub) =>
      "{\"element\": \"" ++ n ++ "\", \"arg\": \"" ++ v.argText ++ "\", " ++ sub.render.drop 1
    "{\"attrs\": {" ++ ", ".intercalate as ++ "}, \"elements\": [" ++ ", ".intercalate es ++ "]}"

def renderRes : Res → String
  | .continue env st =>
    let rc := match lookup env "rc" with
      | some (.v (.lit (.int n))) => toString n
      | _ => "null"
    "\"outcome\": \"continue\", \"rc\": " ++ rc ++ ", \"state\": " ++ st.render
  | .raise x _ st => "\"outcome\": \"raise\", \"value\": " ++ x.render ++ ", \"state\": " ++ st.render
  | .ret x _ st => "\"outcome\": \"return\", \"value\": " ++ x.render ++ ", \"state\": " ++ st.render
  | .failure => "\"outcome\": \"failure\""

/-- Run entry `a` exactly as the OCaml driver does: `Action ("rc", a, ())` from `init_env`. -/
def runEntry {Act : Type} (actDef : Act → Stmt Act) (fuel : Nat) (a : Act) (st : St) : Res :=
  interp actDef fuel (.action "rc" a (.lit .unit)) initEnv st

end CalculusNested
