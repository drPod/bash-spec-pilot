          "annotations": [],
          "text": "{\"lean_source\":\"namespace Pipeline.Generated\\n\\ndef dropSlashes : List Char \u2192 List Char\\n  | [] => []\\n  | c :: cs => if c == '/' then dropSlashes cs else c :: cs\\n\\ndef allSlashes : List Char \u2192 Bool\\n  | [] => true\\n  | c :: cs => if c == '/' then allSlashes cs else false\\n\\ndef trimTrailingSlashes (xs : List Char) : List Char :=\\n  (dropSlashes xs.reverse).reverse\\n\\ndef lastComponent : List Char \u2192 List Char \u2192 List Char\\n  | [], acc => acc\\n  | c :: cs, acc => if c == '/' then lastComponent cs [] else lastComponent cs (acc ++ [c])\\n\\ndef basename (s : String) : String :=\\n  match s.toList with\\n  | [] => String.ofList ['.']\\n  | cs =>\\n      if allSlashes cs then\\n        String.ofList ['/']\\n      else\\n        String.ofList (lastComponent (trimTrailingSlashes cs) [])\\n\\ndef run (args stdin : List String) : List String \u00d7 UInt32 :=\\n  match args with\\n  | [x] => ([basename x], 0)\\n  | _ => ([], 1)\\n\\n theorem run_one_output (x : String) (stdin : List String) :\\n    (run [x] stdin).1 = [basename x] := by\\n  rfl\\n\\n theorem run_one_output_length (x : String) (stdin : List String) :\\n    (run [x] stdin).1.length = 1 := by\\n  simp [run]\\n\\n theorem run_one_exit_success (x : String) (stdin : List String) :\\n    (run [x] stdin).2 = 0 := by\\n  rfl\\n\\n theorem run_one_stdin_ignored (x : String) (s\u2081 s\u2082 : List String) :\\n    run [x] s\u2081 = run [x] s\u2082 := by\\n  rfl\\n\\n theorem output_length_bound (args stdin : List String) :\\n    (run args stdin).1.length \u2264 1 := by\\n  cases args with\\n  | nil => simp [run]\\n  | cons a rest =>\\n      cases rest with\\n      | nil => simp [run]\\n      | cons b rest => simp [run]\\n\\nend Pipeline.Generated\",\"spec_theorems\":[{\"name\":\"run_one_output\",\"informal\":\"For exactly one pathname operand, basename writes exactly one output line containing the documented resulting pathname component.\"},{\"name\":\"run_one_output_length\",\"informal\":\"For exactly one pathname operand, successful basename output consists of exactly one line.\"},{\"name\":\"run_one_exit_success\",\"informal\":\"A basename invocation with exactly one operand completes successfully with exit code zero.\"},{\"name\":\"run_one_stdin_ignored\",\"informal\":\"Basename does not use standard input, so changing stdin does not change its result.\"},{\"name\":\"output_length_bound\",\"informal\":\"The modeled utility produces at most one output line for every argument list.\"}]}",
