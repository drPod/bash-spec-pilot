          "text": "{\"lean_source\":\"namespace Pipeline.Generated\\n\\ndef allSlashNonempty : List Char \u2192 Bool\\n  | [] => true\\n  | c :: cs => if c = '/' then allSlashNonempty cs else false\\n\\ndef allSlash : List Char \u2192 Bool\\n  | [] => false\\n  | c :: cs => allSlashNonempty (c :: cs)\\n\\ndef dropLeadingSlashes : List Char \u2192 List Char\\n  | [] => []\\n  | c :: cs => if c = '/' then dropLeadingSlashes cs else c :: cs\\n\\ndef trimTrailingSlashes (xs : List Char) : List Char :=\\n  (dropLeadingSlashes xs.reverse).reverse\\n\\ndef scanLastSlash : List Char \u2192 List Char \u2192 Option (List Char) \u2192 Option (List Char)\\n  | [], _, best => best\\n  | c :: cs, seen, best =>\\n      if c = '/' then\\n        scanLastSlash cs seen (some seen)\\n      else\\n        scanLastSlash cs (seen ++ [c]) best\\n\\ndef dirnameChars (xs : List Char) : List Char :=\\n  if allSlash xs then\\n    match xs with\\n    | ['/', '/'] => xs\\n    | _ => ['/']\\n  else\\n    let trimmed := trimTrailingSlashes xs\\n    match scanLastSlash trimmed [] none with\\n    | none => ['.']\\n    | some pfx =>\\n        let p := trimTrailingSlashes pfx\\n        match p with\\n        | [] => ['/']\\n        | _ => p\\n\\ndef dirname (s : String) : String :=\\n  String.mk (dirnameChars s.toList)\\n\\ndef run (args stdin : List String) : List String \u00d7 UInt32 :=\\n  match args with\\n  | [s] => ([dirname s], 0)\\n  | _ => ([], 1)\\n\\ntheorem run_single_operand (s : String) (stdin : List String) :\\n    run [s] stdin = ([dirname s], 0) := by\\n  rfl\\n\\ntheorem output_has_one_line (s : String) (stdin : List String) :\\n    (run [s] stdin).1.length = 1 := by\\n  rfl\\n\\ntheorem output_length_bound (s : String) (stdin : List String) :\\n    (run [s] stdin).1.length \u2264 1 := by\\n  change 1 \u2264 1\\n  exact Nat.le_refl 1\\n\\ntheorem output_is_documented_parent (s : String) (stdin : List String) :\\n    (run [s] stdin).1 = [String.mk (dirnameChars s.toList)] := by\\n  rfl\\n\\ntheorem successful_exit_code (s : String) (stdin : List String) :\\n    (run [s] stdin).2 = 0 := by\\n  rfl\\n\\ntheorem stdin_is_ignored (s : String) (a b : List String) :\\n    run [s] a = run [s] b := by\\n  rfl\\n\\nend Pipeline.Generated\\n\",\"spec_theorems\":[{\"name\":\"run_single_operand\",\"informal\":\"With exactly one pathname operand, the utility returns the computed dirname line and successful exit status.\"},{\"name\":\"output_has_one_line\",\"informal\":\"For every single pathname operand, stdout consists of exactly one line.\"},{\"name\":\"output_length_bound\",\"informal\":\"For every single pathname operand, the number of output lines is at most one.\"},{\"name\":\"output_is_documented_parent\",\"informal\":\"The sole output line is the pathname produced by the documented dirname algorithm.\"},{\"name\":\"successful_exit_code\",\"informal\":\"A single valid pathname operand completes successfully with exit code zero.\"},{\"name\":\"stdin_is_ignored\",\"informal\":\"The result for a pathname operand is independent of the supplied stdin lines.\"}]}",
